# recsterio Telegram bot — environment template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in .env.
# NEVER hardcode these values in source.

# ---- Telegram ----
# Token from @BotFather. The bot refuses to start without it.
TELEGRAM_BOT_TOKEN=1234567890:replace-me

# ---- Backend API ----
# Service token, sent as `Authorization: Bearer <BOT_API_TOKEN>`.
BOT_API_TOKEN=replace-me-with-a-shared-service-token
# Base URL of the backend API (must include the /api/v1 prefix).
BOT_API_BASE_URL=http://localhost:8000/api/v1

# ---- Admins ----
# Comma separated Telegram user ids allowed to run /jobs, /retry, /jobretry.
# FALLBACK ONLY: admin rights also come from console accounts with the admin
# role that are linked to this bot (/start link-<code>, see /whoami). Once
# every admin has linked their console account this list can be left empty.
ADMIN_TELEGRAM_IDS=123456789

# ---- Web frontends (the "Go to portal" / "Go to admin" buttons) ----
# Telegram REFUSES a loopback URL in an inline button ("wrong http url") and
# fails the whole message, so a button whose base URL is localhost/127.0.0.1
# is hidden and a one-time warning is logged. A LAN address IS accepted, which
# is how local development works: put this machine's IP here
# (`ipconfig getifaddr en0`) and a phone on the same Wi-Fi can open the page.
PORTAL_FRONTEND_URL=http://localhost:5174
# The admin console. In production it is served under /console/, so the
# deployed value looks like https://your-host/console.
ADMIN_FRONTEND_URL=http://localhost:5173

# ---- Optional tuning (defaults shown) ----
# HTTP timeout for a single backend call, seconds.
REQUEST_TIMEOUT_SECONDS=15
# How often the background watcher polls a video, seconds.
POLL_INTERVAL_SECONDS=5
# How long the watcher keeps polling before giving up, seconds (~20 min).
POLL_TIMEOUT_SECONDS=1200
# Retries for a network failure before giving up.
MAX_RETRIES=3
# Base delay for the exponential backoff between retries, seconds.
RETRY_BACKOFF_SECONDS=0.5
# Transcripts longer than this are sent as a .txt file instead of a message.
TRANSCRIPT_TEXT_LIMIT=3000
# Largest cookies.txt accepted by /cookies (a real one is a few hundred bytes).
COOKIES_MAX_BYTES=2097152
# How often the linked-console admin id cache is refreshed, minutes.
ADMIN_IDS_REFRESH_MINUTES=5
